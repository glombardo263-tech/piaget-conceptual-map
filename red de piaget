def add(content):
    svg.append(content)


def rectangle(x, y, w, h, color, radius=18,
              border=None):

    stroke = border or color

    add(f"""
    <rect x="{x}" y="{y}" width="{w}" height="{h}"
          rx="{radius}"
          fill="{color}"
          stroke="{stroke}"
          stroke-width="1.5"/>
    """)


def text(x, y, content, size=18,
         color=None, weight="normal",
         anchor="start"):

    content = escape(str(content))

    color = color or COLORS["white"]

    add(f"""
    <text x="{x}" y="{y}"
          fill="{color}"
          font-family="Arial, sans-serif"
          font-size="{size}"
          font-weight="{weight}"
          text-anchor="{anchor}">
          {content}
    </text>
    """)


def line(x1, y1, x2, y2, color=None):

    add(f"""
    <line x1="{x1}" y1="{y1}"
          x2="{x2}" y2="{y2}"
          stroke="{color or COLORS['line']}"
          stroke-width="2"/>
    """)


def card(x, y, w, h, title,
         description, color):

    rectangle(x, y, w, h, COLORS["panel"],
              border=COLORS["line"])

    text(x + 22, y + 38, title,
         21, color, "bold")

    current_y = y + 76

    for item in description:
        text(x + 22, current_y,
             "• " + item, 15, COLORS["muted"])

        current_y += 29


